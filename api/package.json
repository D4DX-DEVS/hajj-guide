{
  "name": "hajj-guide-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Content CMS + user data API for the Hajj & Umrah Guide app (Cloudflare Workers + D1 + R2)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hajj-guide --local",
    "db:migrate:remote": "wrangler d1 migrations apply hajj-guide --remote",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "migrate-mongo": "node scripts/migrate-mongo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb": "^6.9.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261103.1": true
  }
}
