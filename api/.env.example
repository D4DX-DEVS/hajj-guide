# ---- core ----
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/hajj_guide

# ---- admin auth ----
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_at_least_32_chars_long_secret
JWT_REFRESH_SECRET=change_me_too_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- cors ----
# comma separated list, or * for all
CORS_ORIGINS=http://localhost:5173

# ---- firebase (app-user auth) ----
# base64 of the service-account JSON:
# node -e "console.log(Buffer.from(require('fs').readFileSync('service-account.json')).toString('base64'))"
# leave empty in dev -> /api/v1/me/* routes return 503 instead of crashing
FIREBASE_SERVICE_ACCOUNT=

# ---- media (DigitalOcean Spaces / any S3) ----
# leave empty -> /api/admin/upload returns 503
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=blr1
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_CDN_URL=

# ---- rate limits (requests per minute) ----
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_USER=120
